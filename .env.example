# Copy to .env (never commit .env). The app reads plain environment variables;
# load them with `set -a; . ./.env; set +a` before running.
APP_ENV=development
DATABASE_URL=postgresql://trustvault:trustvault@localhost:5432/trustvault
TEST_DATABASE_URL=postgresql://trustvault:trustvault@localhost:5432/trustvault_test
MASTER_KEY=change-me-to-a-long-random-string
SECRET_KEY=change-me-too
COOKIE_SECURE=false
STORAGE_BACKEND=db
